#!/usr/bin/make -f

APPDIR = debian/sysmon/usr/lib/sysmon/app

%:
	dh $@

override_dh_auto_install:
	install -D -m 0755 -t $(APPDIR) sysmon.py systemsupport.py
	install -D -m 0644 -t $(APPDIR) configfile.py fanspeed.py icon.svg
	install -D -m 0755 debian/sysmon.launcher debian/sysmon/usr/bin/sysmon
	install -D -m 0644 debian/sysmon.desktop debian/sysmon/usr/share/applications/sysmon.desktop
	install -D -m 0644 icon.svg debian/sysmon/usr/share/icons/hicolor/scalable/apps/sysmon.svg
