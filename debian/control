Depends: ${misc:Depends},
         python3 (>= 3.10),
         python3-venv,
         python3-pyqt6,
         python3-pyqt6.qtcharts,
         python3-gpiozero,
         python3-rpi-lgpio | python3-rpi.gpio,
         smartmontools,
